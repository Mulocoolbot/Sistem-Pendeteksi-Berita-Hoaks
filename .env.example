# Wajib: API Key Groq untuk analisis teks dan ekstraksi gambar (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/groq.ts)
GROQ_API_KEY=

# Opsional (Primary Search & Fact-Check): API Key Tavily untuk pencarian berita terstruktur dan verifikasi domain pemeriksa fakta (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/search.ts & src/lib/services/factcheck.ts)
TAVILY_API_KEY=

# Opsional (Reader & Search Fallback): API Key Jina AI untuk meningkatkan rate limit Jina Reader (r.jina.ai) dan Jina Search (s.jina.ai) (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/scraper.ts, search.ts, & factcheck.ts)
JINA_API_KEY=
