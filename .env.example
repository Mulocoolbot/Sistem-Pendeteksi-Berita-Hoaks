# Wajib: API Key Groq untuk analisis teks dan ekstraksi gambar (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/groq.ts)
GROQ_API_KEY=

# Opsional: API Key Google Fact Check Tools untuk verifikasi klaim (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/factcheck.ts)
GOOGLE_FACT_CHECK_API_KEY=

# Opsional: API Key & Search Engine ID Google Custom Search untuk pencarian berita terkait (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/search.ts)
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
