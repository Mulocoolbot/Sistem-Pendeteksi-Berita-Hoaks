# Wajib: API Key Groq untuk analisis teks dan ekstraksi gambar (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/ai-router.ts & groq.ts)
GROQ_API_KEY=

# Opsional (Multi-Model Routing): Override model Groq untuk tiap peran tugas AI (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/ai-router.ts)
GROQ_MODEL_FAST=llama-3.3-70b-versatile
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct

# Opsional (Custom OpenAI-Compatible Endpoint): Sambungkan fine-tuned / custom LLM endpoint di masa depan
AI_CUSTOM_BASE_URL=
AI_CUSTOM_API_KEY=
AI_CUSTOM_MODEL=

# Opsional (Primary Search & Fact-Check): API Key Tavily untuk pencarian berita terstruktur dan verifikasi domain pemeriksa fakta (dibaca di src/lib/config.ts, digunakan oleh src/lib/services/search.ts & src/lib/services/factcheck.ts)
TAVILY_API_KEY=

# Opsional (Reader, Search Fallback & Semantic Reranker): API Key Jina AI untuk Jina Reader (r.jina.ai), Jina Search (s.jina.ai), dan Jina Reranker v2 (api.jina.ai/v1/rerank) (digunakan oleh src/lib/services/scraper.ts, search.ts, factcheck.ts, & reranker.ts)
JINA_API_KEY=
