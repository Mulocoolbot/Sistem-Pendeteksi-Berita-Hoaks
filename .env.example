# Wajib: Groq API Key untuk analisis teks dan gambar (src/lib/services/groq.ts)
GROQ_API_KEY=your_groq_api_key_here

# Opsional: Google Fact Check Tools API Key (src/lib/services/factcheck.ts)
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# Opsional: Google Custom Search API Key & Search Engine ID (src/lib/services/search.ts)
GOOGLE_CUSTOM_SEARCH_API_KEY=your_google_custom_search_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_google_search_engine_id_here
